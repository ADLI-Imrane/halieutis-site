# Copy to .env.local for `npm run dev`. On Vercel, set these in
# Project Settings → Environment Variables. Never commit real values.

# --- Public (inlined into the browser bundle; safe by design) ---
# Supabase is used only for admin login (Supabase Auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) ---
# Submissions Worker (cloudflare/worker), e.g. https://halieutis-submissions-api.<subdomain>.workers.dev
# Local: http://127.0.0.1:8787 while `npm run dev` runs in cloudflare/worker.
SUBMISSIONS_API_URL=
# Same values as the Worker secrets of the same name.
SUBMIT_API_TOKEN=
ADMIN_API_TOKEN=
# Resend: contact form email notifications.
RESEND_API_KEY=
