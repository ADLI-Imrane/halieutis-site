# Copy to .env.local for `npm run dev`. On Vercel, set these in
# Project Settings → Environment Variables. Never commit real values.
# All of these are server-only: never prefix them with NEXT_PUBLIC_.

# Admin dashboard login (/dashboard/login). The password must be at least
# 12 characters; a shorter one disables the login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Submissions Worker (cloudflare/worker), e.g. https://halieutis-submissions-api.<subdomain>.workers.dev
# Local: http://127.0.0.1:8787 while `npm run dev` runs in cloudflare/worker.
SUBMISSIONS_API_URL=
# Same values as the Worker secrets of the same name.
SUBMIT_API_TOKEN=
ADMIN_API_TOKEN=

# Resend: contact form email notifications.
RESEND_API_KEY=
