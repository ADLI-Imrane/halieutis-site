{
  "name": "halieutis-submissions-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply halieutis-submissions --local",
    "db:migrate:remote": "wrangler d1 migrations apply halieutis-submissions --remote",
    "db:backup": "mkdir -p backups && wrangler d1 export halieutis-submissions --remote --output=backups/halieutis-submissions-$(date -u +%Y%m%dT%H%M%SZ).sql"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.143.1"
  }
}
